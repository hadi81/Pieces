	  . = ALIGN(4);
	  _eosection1 = .;
_szosection1 = _eosection1 - _sosection1data;  }  > RAM 
  .osection2data : AT (COMPARTMENT_DATA_START + COMPARTMENT_DATA_COUNTER) 
