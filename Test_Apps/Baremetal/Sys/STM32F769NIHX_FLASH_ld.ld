_ecsection1 = .;
_szcsection1 = _ecsection1 - _scsection1;  } > FLASH 
COMPARTMENT_CODE_COUNTER = COMPARTMENT_CODE_COUNTER + SIZEOF(.csection1); 
  .csection2 (CODE_SECTIONS_START + COMPARTMENT_CODE_COUNTER) : AT(CODE_SECTIONS_START + COMPARTMENT_CODE_COUNTER)
