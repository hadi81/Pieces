    . = ALIGN(4);
    _ebss = .;         /* define a global symbol at bss end */
    __bss_end__ = _ebss;
  } >RAM

COMPARTMENT_DATA_START = LOADADDR(.data) + SIZEOF(.data); 
COMPARTMENT_DATA_COUNTER = 0;
  .osection0data : AT (COMPARTMENT_DATA_START + COMPARTMENT_DATA_COUNTER) 
