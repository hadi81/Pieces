      . = ALIGN(4);
      _ertmkdata = .;      /* end address symbol */
      . = __rtmk_data_region_end__;
      _szrtmkdata = _ertmkdata - _srtmkdata;
  } >RAM AT> FLASH

  _lrtmkdata = LOADADDR(.rtmkdata);

  /* Constant data into "FLASH" Rom type memory */
  .rodata :
  {
    . = ALIGN(4);
    *(.rodata)         /* .rodata sections (constants, strings, etc.) */
    *(.rodata*)        /* .rodata* sections (constants, strings, etc.) */
    . = ALIGN(4);
  } >FLASH

  .ARM.extab : /* The "READONLY" keyword is only supported in GCC11 and later, remove it if using GCC10 or earlier. */
  {
    . = ALIGN(4);
    *(.ARM.extab* .gnu.linkonce.armextab.*)
