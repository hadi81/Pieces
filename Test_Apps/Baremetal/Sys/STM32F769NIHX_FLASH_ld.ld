    *(.glue_7t)        /* glue thumb to arm code */
    *(.eh_frame)
    KEEP (*(.init))
    KEEP (*(.fini))
    . = ALIGN(4);
   . = __privileged_functions_region_end__;
    _etext = .;        /* define a global symbols at end of code */

  } >FLASH

    .rtmkcode :
  {
    _srtmkcode = .;
    . = ALIGN(4);
    *libc_a*:(.text*)
    *libc.a:(.text*)
    *libm.a:(.text*)
    *libstdc++.a:(.text*)
    *(.rtmkcode)           /* .text sections (code) */
    *(.rtmkcode*)          /* .text* sections (code) */
    *(.glue_7)         /* glue arm to thumb code */
    *(.glue_7t)        /* glue thumb to arm code */
    *(.eh_frame)
    KEEP (*(.init))
    KEEP (*(.fini))

    . = ALIGN(4);
    _etext = .;        /* define a global symbols at end of code */
    _ertmkcode = .;
    . = __rtmk_code_region_end__;
  } >FLASH


  .rtmkdata : 
  { 
      _srtmkdata  = .;      /* start address symbol */
      _srtmkdata2 = .;
      . = ALIGN(4);
      *(privileged_data)
