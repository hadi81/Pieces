/* Entry Point */
ENTRY(Reset_Handler)

/* Memories definition */
MEMORY
{
  RAM    (xrw)    : ORIGIN = 0x20000000,   LENGTH = 512K
  FLASH    (rx)    : ORIGIN = 0x8000000,   LENGTH = 2048K
}

/* Highest address of the user mode stack */
_estack = ORIGIN(RAM) + LENGTH(RAM); /* end of "RAM" Ram type memory */

_Min_Heap_Size = 0x400; /* required amount of heap */
_Min_Stack_Size = 0x400; /* required amount of stack */

__privileged_functions_region_size__ = 0x100000;  /* 1 MB */
__privileged_functions_region_end__  = ORIGIN(FLASH) + __privileged_functions_region_size__;

__rtmk_code_region_size__ = 0x4000;  /* 16 KB */
__rtmk_code_region_end__  = __privileged_functions_region_end__ + __rtmk_code_region_size__;

__rtmkdata_region_size__ = 0x2000;             /* 8 KB */
__rtmk_data_region_end__  =  ORIGIN(RAM) + __rtmkdata_region_size__;

/* Sections */
