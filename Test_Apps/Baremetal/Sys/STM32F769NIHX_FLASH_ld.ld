	  _eosection2 = .;
_szosection2 = _eosection2 - _sosection2data;  }  > RAM 
	
CODE_SECTIONS_START = LOADADDR(.osection2data) + SIZEOF(.osection2data);
COMPARTMENT_CODE_COUNTER = 0;
  .csection0 (CODE_SECTIONS_START + COMPARTMENT_CODE_COUNTER) : AT(CODE_SECTIONS_START + COMPARTMENT_CODE_COUNTER)
  {
_scsection0 = .;
	  . = ALIGN(4);
	  *(.csection0)
	  . = ALIGN(4);
_ecsection0 = .;
_szcsection0 = _ecsection0 - _scsection0;  } > FLASH 
COMPARTMENT_CODE_COUNTER = COMPARTMENT_CODE_COUNTER + SIZEOF(.csection0); 
  .csection1 (CODE_SECTIONS_START + COMPARTMENT_CODE_COUNTER) : AT(CODE_SECTIONS_START + COMPARTMENT_CODE_COUNTER)
  {
